# App
ENVIRONMENT=development
API_PREFIX_V1=/api/v1

# Logging (fastapi-structlog / LogSettings)
LOG__LOG_LEVEL=INFO
LOG__JSON_LOGS=true

# Host (uvicorn)
HOST__HOST=127.0.0.1
HOST__PORT=8000

# Auth JWT
AUTH_JWT__SECRET_KEY=change-me-to-secure-key-min-32-chars!!
AUTH_JWT__ALGORITHM_JWT=HS256
AUTH_JWT__ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_JWT__REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI credentials (used when DAY_SUMMARY__PROVIDER=openai).
# Leave API key empty to use template fallback inside the OpenAI client.
OPENAI__API_KEY=
OPENAI__MODEL=gpt-4.1-mini
OPENAI__MAX_COMPLETION_TOKENS=1024
OPENAI__ENABLED=true
# Estimated USD per 1M tokens for cost logging (adjust for your model).
OPENAI__INPUT_PRICE_PER_1M_TOKENS=0.40
OPENAI__OUTPUT_PRICE_PER_1M_TOKENS=1.60

# Day summary provider: openai | template
DAY_SUMMARY__PROVIDER=openai

# Telegram bot (optional). Leave BOT_TOKEN empty to skip local bot startup.
# 1) Create a bot via @BotFather
# 2) Register a user via POST /api/v1/auth/register
# 3) /login in Telegram with that email+password
TELEGRAM__BOT_TOKEN=
TELEGRAM__API_BASE_URL=http://127.0.0.1:8000
TELEGRAM__ARTIFACT_POLL_INTERVAL_SECONDS=2
TELEGRAM__ARTIFACT_POLL_TIMEOUT_SECONDS=90

# Redis / Taskiq
REDIS__HOST=localhost
REDIS__PORT=6379
TASKIQ__QUEUE_NAME=taskiq_queue
TASKIQ__DEFAULT_RETRY_COUNT=3
TASKIQ__DAY_SUMMARY_MAX_RETRIES=3
TASKIQ__DAY_SUMMARY_RETRY_ON_ERROR=true

# Staging (optional)
STAGING__MAX_USERS=100

# Database
DB__POSTGRES_USER=postgres
DB__POSTGRES_PASSWORD=secret
DB__POSTGRES_HOST=localhost
DB__POSTGRES_PORT=5432
DB__POSTGRES_DB=personal_ai_assistant

# Database connection pool (optional)
DB__POOL_SIZE=20
DB__MAX_OVERFLOW=10
DB__POOL_PRE_PING=true
DB__POOL_RECYCLE=3600
DB__POOL_TIMEOUT=30
DB__ECHO=false
DB__ECHO_POOL=false
